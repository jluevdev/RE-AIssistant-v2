rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function authEmail() { return isSignedIn() ? request.auth.token.email : null; }
    function userTeamId() {
      return isSignedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamId : null;
    }
    function sameTeam(resource) {
      return isSignedIn() && resource.data.teamId != null && resource.data.teamId == userTeamId();
    }
    function isTeamMember(teamId) {
      return isSignedIn()
        && userTeamId() != null
        && userTeamId() == teamId;
    }
    function isTeamAdmin(teamId) {
      return isTeamMember(teamId)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamRole in ['owner', 'admin'];
    }
    function ownsResource(resource) {
      return isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.agentId == request.auth.uid ||
        sameTeam(resource)
      );
    }
    function openHouseDoc(openHouseId) {
      return get(/databases/$(database)/documents/openHouses/$(openHouseId));
    }
    function canAccessOpenHouse(openHouseId) {
      return isSignedIn()
        && openHouseDoc(openHouseId).exists
        && (
          openHouseDoc(openHouseId).data.ownerUid == request.auth.uid ||
          openHouseDoc(openHouseId).data.agentId == request.auth.uid ||
          sameTeam(openHouseDoc(openHouseId))
        );
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function teamBillingActive() {
      let teamId = userData().get('teamId', '');
      return teamId is string
        && teamId.size() > 0
        && exists(/databases/$(database)/documents/teams/$(teamId))
        && get(/databases/$(database)/documents/teams/$(teamId)).data.get('billing', {}).get('status', '') in ['active', 'trialing'];
    }

    function outboundAllowed() {
      let sub = userData().get('subscription', {});
      let plan = sub.get('plan', 'trial');
      let status = sub.get('status', '');
      let stripeId = sub.get('stripeSubscriptionId', '');
      let blocked = status in ['canceled', 'unpaid', 'incomplete_expired'];
      let hasStripe = stripeId is string && stripeId.size() > 0;
      let paidPlan = plan is string && plan.size() > 0 && plan != 'trial';
      let paid = !blocked && (hasStripe || paidPlan);
      let end = sub.get('endDate', null);
      let trialOpen = end == null || end > request.time;
      return paid || trialOpen || teamBillingActive();
    }

    // Users: self-access only; teamId/teamRole are server-managed
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['subscription']);
      allow update: if isOwner(userId)
        && request.resource.data.get('teamId', null) == resource.data.get('teamId', null)
        && request.resource.data.get('teamRole', null) == resource.data.get('teamRole', null)
        && request.resource.data.get('subscription', null) == resource.data.get('subscription', null)
        && request.resource.data.get('line', null) == resource.data.get('line', null)
        && request.resource.data.get('guardrailLevel', null) == resource.data.get('guardrailLevel', null)
        && request.resource.data.get('pendingAction', null) == resource.data.get('pendingAction', null)
        && request.resource.data.get('useOwnAiKey', null) == resource.data.get('useOwnAiKey', null)
        && request.resource.data.get('activeBotId', null) == resource.data.get('activeBotId', null);
      allow delete: if isOwner(userId);
    }

    // Teams & membership — reads for members; writes via Cloud Functions only
    match /teams/{teamId} {
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        isTeamMember(teamId)
      );
      allow write: if false;

      match /members/{memberUid} {
        allow read: if isSignedIn() && (
          isTeamMember(teamId) ||
          memberUid == request.auth.uid
        );
        allow write: if false;
      }
    }

    match /teamInvites/{inviteId} {
      allow read: if isSignedIn() && (
        resource.data.email == authEmail() ||
        isTeamAdmin(resource.data.teamId)
      );
      allow write: if false;
    }

    // Messages: owner OR team scope
    match /messages/{docId} {
      allow read: if isSignedIn() && (
        resource.data.agentUid == request.auth.uid ||
        resource.data.agentEmail == authEmail() ||
        sameTeam(resource)
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.agentUid == request.auth.uid ||
        resource.data.agentEmail == authEmail() ||
        sameTeam(resource)
      );
    }

    // Offers: owner/team scope; writes via Cloud Functions only
    match /offers/{offerId} {
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        sameTeam(resource)
      );
      allow create, update, delete: if false;

      match /events/{eventId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/offers/$(offerId)).data.ownerUid == request.auth.uid ||
          sameTeam(get(/databases/$(database)/documents/offers/$(offerId)))
        );
        allow write: if false;
      }
    }

    // Listings: owner/team scope (listing hub submit uses callables, not client reads)
    match /listings/{listingId} {
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read, update, delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        sameTeam(resource)
      );
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    // Open Houses: public read for check-in page
    match /openHouses/{openHouseId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.ownerUid == request.auth.uid ||
        request.resource.data.agentId == request.auth.uid
      ) && outboundAllowed();
      allow update, delete: if ownsResource(resource);
    }

    // Public check-in creates visitor rows; agents read their open-house visitors only
    match /openHouseVisitors/{visitorId} {
      allow create: if request.resource.data.openHouseId != null
        && exists(/databases/$(database)/documents/openHouses/$(request.resource.data.openHouseId));
      allow read, update, delete: if isSignedIn() && (
        resource.data.agentId == request.auth.uid ||
        canAccessOpenHouse(resource.data.openHouseId)
      );
    }

    // Feedback written by Cloud Functions only
    match /openHouseFeedback/{feedbackId} {
      allow read: if isSignedIn() && canAccessOpenHouse(resource.data.openHouseId);
      allow write: if false;
    }

    // Reminder docs managed by Cloud Functions / scheduler only
    match /openHouseReminders/{id} {
      allow read, write: if false;
    }

    // Automation settings: owner only
    match /automationSettings/{ownerUid} {
      allow read: if isSignedIn() && request.auth.uid == ownerUid;
      allow create, update: if isSignedIn()
        && request.auth.uid == ownerUid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isSignedIn() && request.auth.uid == ownerUid;
    }

    // Scheduled automation tasks: owner read; Cloud Functions write only
    match /scheduledTasks/{taskId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /openHouseVerifications/{id} {
      allow read, write: if false;
    }

    // Flyer requests created by Cloud Functions only
    match /flyerRequests/{id} {
      allow read: if isSignedIn() && canAccessOpenHouse(resource.data.openHouseId);
      allow write: if false;
    }

    match /smsListings/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /contacts/{contactId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /agents/{userId}/clients/{clientId} {
      allow read: if isSignedIn() && userId == request.auth.uid;
      allow write: if false;
    }

    match /appointments/{appointmentId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /buyerSchedules/{scheduleId} {
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid && outboundAllowed();
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /clientPlanTokens/{tokenId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /trialSurveys/{surveyId} {
      allow read, write: if false;
    }

    match /aiCredentials/{userId} {
      allow read, write: if false;
    }

    match /platformConfig/{docId} {
      allow read, write: if false;
    }

    match /users/{userId}/assistantBots/{botId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /dnc/{phone} {
      allow read, write: if false;
    }

    match /consents/{phone} {
      allow read, write: if false;
    }

    match /smsRouting/{phone} {
      allow read, write: if false;
    }

    match /agentLines/{phone} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /pendingActions/{actionId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /signaturePackets/{packetId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    match /signatureInvites/{token} {
      allow read, write: if false;
    }

    match /users/{userId}/guardrailAudits/{auditId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
