VITE_FIREBASE_APP_ID=1:532867485237:web:c009eec0d5ccb1a1a2eb7c

# Stripe (TEST MODE until you switch to live keys)
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PRICE_SINGLE_AGENT=
VITE_STRIPE_PRICE_ALL_INCLUSIVE=
VITE_STRIPE_PRICE_ALL_INCLUSIVE_YEARLY=
