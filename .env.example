# Optional frontend
VITE_GOOGLE_MAPS_API_KEY=

# SmartShowings is off unless this is the string true. Rebuild the web app after changing it.
VITE_SMART_SHOWINGS_ENABLED=false

# Cloud Functions — set as Firebase secrets (see scripts/set-firebase-secrets.ps1)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SINGLE_AGENT=
STRIPE_PRICE_ALL_INCLUSIVE=
STRIPE_PRICE_ALL_INCLUSIVE_YEARLY=
STRIPE_PRICE_PREMIUM_TEAM=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WEBHOOK_URL=

# Optional Cloud Functions env (non-secret)
# Public texts and emails use https://reaissistant.com unless FRONTEND_URL is localhost
# or another custom domain. *.web.app values are ignored for those links.
FRONTEND_URL=http://localhost:5173
# SmartShowings stays off until this is true. SMS stays mock until SMART_SHOWINGS_SMS_MODE=live.
SMART_SHOWINGS_ENABLED=false
SMART_SHOWINGS_SMS_MODE=mock
SMART_SHOWINGS_EMAIL_MODE=mock
GOOGLEAI_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
