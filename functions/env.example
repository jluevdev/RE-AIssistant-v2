# Copied into the environment that runs Cloud Functions.
# SmartShowings is on unless SMART_SHOWINGS_ENABLED=false.
SMART_SHOWINGS_ENABLED=true

# Real SMS is this one change, after Twilio A2P 10DLC is approved.
# Until then leave it mock. Tests and the dev simulator refuse live mode.
SMART_SHOWINGS_SMS_MODE=mock

# Real email is a separate one-line change. Leave mock until you mean to send.
SMART_SHOWINGS_EMAIL_MODE=mock
